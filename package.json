{
  "type": "module",
  "name": "scap",
  "version": "0.0.0",
  "scripts": {
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "build": "tsx build.ts",
    "build:patch": "npm run version:patch && npm run build",
    "build:minor": "npm run version:minor && npm run build",
    "build:major": "npm run version:major && npm run build",
    "lint": "npx eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint:tests": "npx eslint --ext .ts spec/",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts --exec \"tsx --experimental-specifier-resolution=node src/index.ts\"",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "nodemon --config ./spec/nodemon.json",
    "test:no-reloading": "npx ts-node --files -r tsconfig-paths/register ./spec"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "docs"
    ],
    "ext": "ts, html",
    "ignore": [
      "src/public"
    ],
    "execMap": {
      "ts": "ts-node --files -r tsconfig-paths/register"
    }
  },
  "engines": {
    "node": ">=18.8.0"
  },
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-jwt": "^8.4.1",
    "express-list-endpoints": "^7.1.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "inserturlparams": "^1.0.1",
    "jet-logger": "^2.0.1",
    "jet-paths": "^1.0.6",
    "jsonfile": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.0",
    "kafkajs": "^2.2.4",
    "luxon": "^3.7.2",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.1",
    "nodemailer": "^6.9.15",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.2",
    "puppeteer": "^22.13.1",
    "rimraf": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-command-line-args": "^2.5.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jasmine": "^5.1.4",
    "@types/jsonfile": "^6.1.4",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfmake": "^0.2.11",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/utils": "^8.41.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-prettier": "^5.5.4",
    "find": "^0.3.0",
    "fs-extra": "^11.2.0",
    "jasmine": "^5.1.0",
    "nodemon": "^3.1.3",
    "prettier": "^3.6.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.41.0"
  }
}